{
  "base": "main",
  "php": "8.4",
  "chain": false,
  "guard": {
    "deny": [
      "wp-config\\.php$",
      "\\.sql(\\.gz)?$",
      "\\.(csv|tsv|xlsx?)$",
      "\\.env(\\.|$)",
      "\\.pem$",
      "\\.key$"
    ]
  },
  "jobs": [
    {
      "name": "lint",
      "run": "php -l",
      "each": [
        "**/*.php",
        "!vendor/**"
      ],
      "always": true
    },
    {
      "name": "lint-floor",
      "run": "php -l",
      "php": "8.2",
      "each": [
        "**/*.php",
        "!vendor/**",
        "!tests/**"
      ],
      "always": true
    },
    {
      "name": "synced-files",
      "run": "node .claude/skills/synced-files/scripts/check-synced-files.mjs",
      "always": true,
      "requires": [
        "bin:node"
      ]
    },
    {
      "name": "pest-unit",
      "run": "vendor/bin/pest",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "phpunit.xml*",
        "composer.json",
        "composer.lock"
      ]
    },
    {
      "name": "pint",
      "run": "vendor/bin/pint --test",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "pint.json",
        "composer.lock"
      ]
    },
    {
      "name": "rector",
      "run": "vendor/bin/rector --dry-run",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "rector.php",
        "composer.lock"
      ]
    },
    {
      "name": "phpstan",
      "run": "composer stan",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "phpstan.neon*",
        "composer.lock"
      ]
    }
  ]
}
